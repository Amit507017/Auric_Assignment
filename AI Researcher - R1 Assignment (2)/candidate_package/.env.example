# Template for the credentials file. Copy to `.env` and fill in your key.
# The real `.env` is intentionally NOT part of the submission (CANDIDATE_BRIEF.md:
# "do not commit .env or the key to your submission repository"). load_env()
# tolerates a missing .env, so --offline-symbolic runs work without it.
OPENROUTER_API_KEY=<your-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=ibm-granite/granite-4.2-8b
